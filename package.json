{
  "name": "@containerbase/eslint-plugin",
  "version": "0.0.0-PLACEHOLDER",
  "description": "containerbase eslint plugin",
  "keywords": [
    "eslint-plugin",
    "jest",
    "vitest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/containerbase/eslint-plugin.git"
  },
  "license": "MIT",
  "author": "Rhys Arkins <rhys@arkins.net>",
  "contributors": [
    "Michael Kriese <michael.kriese@visualon.de>"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts",
    "rules",
    "types"
  ],
  "scripts": {
    "lint": "run-s prettier oxlint lint:types",
    "lint:types": "run-p 'lint:types:*'",
    "lint:types:default": "tsc",
    "lint-fix": "run-s prettier-fix oxlint-fix",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "prepare": "husky",
    "prettier": "prettier --cache -c -u \"**/*.*\"",
    "prettier-fix": "prettier --cache -w -u \"**/*.*\""
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@tsconfig/node22": "22.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/estree": "1.0.9",
    "@types/node": "22.20.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.12.0",
    "eslint-plugin-promise": "7.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-packagejson": "3.0.2",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-plugin-promise": "^7.0.0"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.11.0 || >=24.10.0",
    "pnpm": ">=10.0.0"
  }
}
